# Mặc định server đọc cả file .env ở thư mục cha (New folder/.env) - nơi đã có OPENAI_API_KEY.
OPENAI_API_KEY=
# LLM điều phối (orchestrator)
OPENAI_MODEL=gpt-5.4-mini
# Tùy chọn: bật Geocoding + Distance Matrix của Google Maps (quãng đường & thời gian Google theo giao thông)
GOOGLE_MAPS_API_KEY=
# Tùy chọn: key riêng cho Maps JavaScript API trên trình duyệt (mặc định dùng GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_BROWSER_KEY=
# Thư mục chứa lightgbm_final.pkl, catboost_final.cbm, submission*.csv (mặc định ../final_model)
# MODEL_DIR=
PORT=8787
MODEL_URL=http://127.0.0.1:8000
